// Prisma schema for PPE Inventory Backend - SQLite compatible (String enums)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model JobPosition {
  id        String    @id @default(cuid())
  code      String    @unique
  nameEn    String
  nameAr    String
  active    Boolean   @default(true)
  deletedAt DateTime?
  employees Employee[]
  kits      Kit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  id                     String               @id @default(cuid())
  code                   String               @unique
  nameEn                 String
  nameAr                 String
  site                   String
  locationType           String
  stockCondition         String               @default("New")
  openingBalanceStatus   String               @default("Open")
  description            String               @default("")
  capacityUnits          Int                  @default(0)
  address                String               @default("")
  active                 Boolean              @default(true)
  deletedAt              DateTime?
  assignedStoreKeepers   LocationStoreKeeper[]
  ppeItemLinks           PPEItemLocation[]
  stockBalances          StockBalance[]
  batches                Batch[]
  stockAdjustments       StockAdjustment[]
  openingBalances        OpeningBalance[]
  issuances              Issuance[]
  scrapEntries           ScrapEntry[]
  receivedReturns        IssuanceReturn[]     @relation("ReturnDestination")
  stockMovementsFrom     StockMovement[]      @relation("MovementFrom")
  stockMovementsTo       StockMovement[]      @relation("TransferDestination")
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
}

model LocationStoreKeeper {
  id         String   @id @default(cuid())
  locationId String
  employeeId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@unique([locationId, employeeId])
}

model Attribute {
  id        String    @id @default(cuid())
  code      String    @unique
  nameEn    String
  nameAr    String
  active    Boolean   @default(true)
  deletedAt DateTime?
  values    AttributeValue[]
  itemGroups ItemGroupAttribute[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AttributeValue {
  id          String    @id @default(cuid())
  value       String
  sortOrder   Int
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  ppeVariantLinks PPEItemVariantValue[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([attributeId, value])
}

model ItemGroup {
  id                  String               @id @default(cuid())
  code                String               @unique
  nameEn              String
  nameAr              String
  requiresGenderMatch Boolean              @default(false)
  active              Boolean              @default(true)
  deletedAt           DateTime?
  attributes          ItemGroupAttribute[]
  ppeItems            PPEItem[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model ItemGroupAttribute {
  id          String    @id @default(cuid())
  itemGroupId String
  attributeId String
  itemGroup   ItemGroup @relation(fields: [itemGroupId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  @@unique([itemGroupId, attributeId])
}

model PPEItem {
  id                       String                 @id @default(cuid())
  itemCode                 String                 @unique
  nameEn                   String
  nameAr                   String
  photoUrl                 String?
  category                 String
  itemGroupId              String
  itemGroup                ItemGroup              @relation(fields: [itemGroupId], references: [id])
  hasSize                  Boolean                @default(false)
  gender                   String
  lifespanType             String
  lifespanValue            Int
  descriptionEn            String                 @default("")
  descriptionAr            String                 @default("")
  manufacturer             String                 @default("")
  model                    String                 @default("")
  standardCertification    String                 @default("")
  riskCategory             String
  reorderLevel             Int
  uom                      String
  active                   Boolean                @default(true)
  deletedAt                DateTime?
  locations                PPEItemLocation[]
  variantValues            PPEItemVariantValue[]
  kitItems                 KitItem[]
  stockBalances            StockBalance[]
  batches                  Batch[]
  stockMovements           StockMovement[]
  stockAdjustments         StockAdjustment[]
  openingBalanceLines      OpeningBalanceLine[]
  issuances                Issuance[]
  scrapEntries             ScrapEntry[]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
}

model PPEItemLocation {
  id         String  @id @default(cuid())
  ppeItemId  String
  locationId String
  ppeItem    PPEItem  @relation(fields: [ppeItemId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  @@unique([ppeItemId, locationId])
}

model PPEItemVariantValue {
  id               String         @id @default(cuid())
  ppeItemId        String
  attributeValueId String
  ppeItem          PPEItem        @relation(fields: [ppeItemId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  @@unique([ppeItemId, attributeValueId])
}

model Kit {
  id            String    @id @default(cuid())
  nameEn        String
  nameAr        String
  jobPositionId String
  jobPosition   JobPosition @relation(fields: [jobPositionId], references: [id])
  active        Boolean   @default(true)
  deletedAt     DateTime?
  items         KitItem[]
  issuances     Issuance[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model KitItem {
  id         String  @id @default(cuid())
  kitId      String
  kit        Kit     @relation(fields: [kitId], references: [id], onDelete: Cascade)
  ppeItemId  String
  ppeItem    PPEItem @relation(fields: [ppeItemId], references: [id])
  qty        Int
  variantKey String?
  @@unique([kitId, ppeItemId])
}

model Employee {
  id                     String               @id @default(cuid())
  employeeCode           String               @unique
  name                   String
  gender                 String               @default("Male")
  employmentStatus       String               @default("Active")
  supervisorId           String?
  supervisor             Employee?            @relation("SupervisorSubordinates", fields: [supervisorId], references: [id])
  subordinates           Employee[]           @relation("SupervisorSubordinates")
  department             String               @default("")
  site                   String               @default("")
  jobPositionId          String
  jobPosition            JobPosition          @relation(fields: [jobPositionId], references: [id])
  role                   String
  passwordHash           String?
  active                 Boolean              @default(true)
  deletedAt              DateTime?
  assignedLocations      LocationStoreKeeper[]
  submittedAdjustments   StockAdjustment[]    @relation("SubmittedBy")
  reviewedAdjustments    StockAdjustment[]    @relation("ReviewedBy")
  issuedIssuances        Issuance[]           @relation("IssuedBy")
  employeeIssuances      Issuance[]           @relation("EmployeeIssuance")
  preparedOpeningBalances OpeningBalance[]      @relation("PreparedBy")
  approvedOpeningBalances OpeningBalance[]      @relation("ApprovedBy")
  scrapEntries           ScrapEntry[]
  auditLogs              AuditLog[]
  stockMovements         StockMovement[]
  issuanceReturns        IssuanceReturn[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
}

model StockBalance {
  id                  String   @id @default(cuid())
  ppeItemId           String
  ppeItem             PPEItem  @relation(fields: [ppeItemId], references: [id], onDelete: Cascade)
  locationId          String
  location            Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  variantKey          String?
  quantityOnHand      Int      @default(0)
  quarantinedQuantity Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  @@unique([ppeItemId, locationId, variantKey])
}

model Batch {
  id                     String          @id @default(cuid())
  batchNumber            String
  ppeItemId              String
  ppeItem                PPEItem         @relation(fields: [ppeItemId], references: [id])
  locationId             String
  location               Location        @relation(fields: [locationId], references: [id])
  quantity               Int
  availableQty           Int
  quarantinedQty         Int             @default(0)
  condition              String          @default("New")
  expiryDate             DateTime?
  manufacturerExpiryDate DateTime?
  costPerUnit            Float?
  status                 String          @default("Active")
  openingBalanceId       String?
  openingBalance         OpeningBalance? @relation(fields: [openingBalanceId], references: [id])
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  @@unique([batchNumber, ppeItemId, locationId])
  @@index([ppeItemId, locationId, status])
}

model StockMovement {
  id           String       @id @default(cuid())
  type         String
  ppeItemId    String
  ppeItem      PPEItem      @relation(fields: [ppeItemId], references: [id])
  locationId   String
  location     Location     @relation("MovementFrom", fields: [locationId], references: [id])
  toLocationId String?
  toLocation   Location?    @relation("TransferDestination", fields: [toLocationId], references: [id])
  quantity     Int
  reason       String
  reference    String       @unique
  approvedBy   String?
  createdBy    String
  creator      Employee     @relation(fields: [createdBy], references: [id])
  createdAt    DateTime     @default(now())
}

model StockAdjustment {
  id             String           @id @default(cuid())
  reference      String           @unique
  type           String
  ppeItemId      String
  ppeItem        PPEItem          @relation(fields: [ppeItemId], references: [id])
  locationId     String
  location       Location         @relation(fields: [locationId], references: [id])
  batchNumber    String
  quantityDelta  Int
  reasonCategory String
  reason         String
  status         String           @default("pending")
  submittedBy    String
  submitter      Employee         @relation("SubmittedBy", fields: [submittedBy], references: [id])
  reviewedBy     String?
  reviewer       Employee?        @relation("ReviewedBy", fields: [reviewedBy], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model OpeningBalance {
  id              String                @id @default(cuid())
  locationId      String
  location        Location              @relation(fields: [locationId], references: [id])
  referenceDate   DateTime
  notes           String?
  status          String                @default("Draft")
  preparedBy      String
  preparer        Employee              @relation("PreparedBy", fields: [preparedBy], references: [id])
  approvedBy      String?
  approver        Employee?             @relation("ApprovedBy", fields: [approvedBy], references: [id])
  rejectionReason String?
  lines           OpeningBalanceLine[]
  batches         Batch[]
  submittedAt     DateTime?
  approvedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model OpeningBalanceLine {
  id               String         @id @default(cuid())
  openingBalanceId String
  openingBalance   OpeningBalance @relation(fields: [openingBalanceId], references: [id], onDelete: Cascade)
  ppeItemId        String
  ppeItem          PPEItem        @relation(fields: [ppeItemId], references: [id])
  batchNumber      String
  expiryDate       DateTime
  quantity         Int
  costPerUnit      Float?
  @@unique([openingBalanceId, ppeItemId, batchNumber])
}

model Issuance {
  id                      String           @id @default(cuid())
  employeeId              String?
  employee                Employee?        @relation("EmployeeIssuance", fields: [employeeId], references: [id])
  holderName              String?
  holderType              String?
  ppeItemId               String?
  ppeItem                 PPEItem?         @relation(fields: [ppeItemId], references: [id])
  kitId                   String?
  kit                     Kit?             @relation(fields: [kitId], references: [id])
  locationId              String
  location                Location         @relation(fields: [locationId], references: [id])
  quantity                Int
  batchNumber             String?
  variantKey              String?
  issueDate               DateTime         @default(now())
  expectedReturnDate      DateTime?
  expectedReplacementDate DateTime?
  storeKeeperSignature    String?
  receiverSignature       String?
  status                  String           @default("issued")
  issuedBy                String
  issuer                  Employee         @relation("IssuedBy", fields: [issuedBy], references: [id])
  returns                 IssuanceReturn[]
  scrapEntries            ScrapEntry[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
}

model IssuanceReturn {
  id                        String          @id @default(cuid())
  issuanceId                String          @unique
  issuance                  Issuance        @relation(fields: [issuanceId], references: [id])
  quantityReturned          Int             @default(1)
  condition                 String
  physicalReceiptConfirmed  Boolean?        @default(false)
  autoScrapped              Boolean         @default(false)
  returnedToLocationId      String?
  returnedToLocation        Location?       @relation("ReturnDestination", fields: [returnedToLocationId], references: [id])
  storeKeeperSignature      String?
  returnerSignature         String?
  returnedBy                String
  returner                  Employee        @relation(fields: [returnedBy], references: [id])
  returnDate                DateTime        @default(now())
  createdAt                 DateTime        @default(now())
}

model ScrapEntry {
  id                 String    @id @default(cuid())
  ppeItemId          String
  ppeItem            PPEItem   @relation(fields: [ppeItemId], references: [id])
  locationId         String
  location           Location  @relation(fields: [locationId], references: [id])
  batchNumber        String?
  quantity           Int
  reason             String
  relatedReferenceId String?
  relatedIssuance    Issuance? @relation(fields: [relatedReferenceId], references: [id])
  reversed           Boolean   @default(false)
  reversedBy         String?
  reversedAt         DateTime?
  reversalReason     String?
  scrappedBy         String
  scrapper           Employee  @relation(fields: [scrappedBy], references: [id])
  createdAt          DateTime  @default(now())
}

model ExpirySettings {
  id                    String @id @default(cuid())
  generalLeadTimeDays   Int    @default(30)
  categoryILeadTimeDays Int    @default(15)
  categoryIILeadTimeDays Int   @default(30)
  categoryIIILeadTimeDays Int  @default(60)
  updatedAt             DateTime @updatedAt
}

model ModuleSettings {
  id                       String   @id @default(cuid())
  reminderLeadTimePerSite  String   @default("{\"Main Campus\":14,\"Cairo Site\":14,\"Alexandria Site\":21}")
  recentIssuanceWindowDays Int      @default(90)
  trashRetentionDays       Int      @default(90)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model AuditLog {
  id            String          @id @default(cuid())
  entityType    String
  entityId      String
  action        String
  details       String?
  beforeValues  String?
  afterValues   String?
  reason        String?
  source        String          @default("Screen")
  retentionFlag String          @default("7_YEARS")
  performedBy   String
  performer     Employee        @relation(fields: [performedBy], references: [id])
  timestamp     DateTime        @default(now())
  @@index([entityType, entityId])
  @@index([timestamp])
}
