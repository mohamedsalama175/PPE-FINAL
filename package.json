{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:client": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "start:all": "npm run build && npm run build:server && npm start",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server prisma/dev.db",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:server": "tsx server/test-comprehensive.ts",
    "test:e2e": "tsx tests/e2e/runner.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@mantine/core": "^8.2.4",
    "@mantine/dates": "^8.2.4",
    "@mantine/hooks": "^8.2.4",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tippyjs/react": "^4.2.6",
    "@vitejs/plugin-react": "^5.0.4",
    "apexcharts": "^7.1.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "flatpickr": "^4.6.13",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "morgan": "^1.12.0",
    "motion": "^12.23.24",
    "multer": "^2.3.0",
    "react": "^19.0.1",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^19.0.1",
    "react-flatpickr": "^4.0.11",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^3.6.0",
    "tippy.js": "^6.3.7",
    "vite": "^6.2.3",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/react-flatpickr": "^3.8.11",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
